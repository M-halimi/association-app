# Runtime connection (Supabase transaction pooler, serverless-safe)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Used by prisma migrate deploy (Supabase session pooler / direct)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Used by NextAuth to sign/verify session JWTs (must be set in Netlify)
AUTH_SECRET="replace-with-a-long-random-secret"
# Your deployed site URL (Netlify domain or custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Netlify: add DATABASE_URL, DIRECT_URL, AUTH_SECRET, and NEXT_PUBLIC_APP_URL
# as four separate environment variables. Do not paste multiple KEY=value
# assignments into the value of DATABASE_URL or DIRECT_URL.
